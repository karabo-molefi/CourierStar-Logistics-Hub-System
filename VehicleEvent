using System;

namespace CourierStarApp
{
    // Custom delegate used by Vehicle's events (satisfies "use delegates to notify subscribers")
    public delegate void VehicleStatusHandler(object sender, VehicleEventArgs e);

    public class VehicleEventArgs : EventArgs
    {
        public int VehicleId { get; }
        public double CurrentLoad { get; }
        public double MaxWeight { get; }
        public string Message { get; }

        public VehicleEventArgs(int vehicleId, double currentLoad, double maxWeight, string message)
        {
            VehicleId = vehicleId;
            CurrentLoad = currentLoad;
            MaxWeight = maxWeight;
            Message = message;
        }
    }
}
